# Copy to .env (or set these in your host's dashboard) for a real deployment.
# Development needs none of them — the defaults keep everything inside the repo.

# ---------------------------------------------------------------------------
# Required in production. Session tokens are signed with this, so anyone who
# has it can mint a token for any account. The server refuses to start in
# production without it, and refuses the development value.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=

NODE_ENV=production

# ---------------------------------------------------------------------------
# Where data lives. Point DATA_DIR at a persistent volume — on most hosts the
# container filesystem is wiped on every deploy, which would take the database
# and every proof photo with it.
#
# DB_FILE and UPLOADS_DIR default to sitting beside DATA_DIR; set them only if
# you want them somewhere else (a separate disk, say).
# ---------------------------------------------------------------------------
DATA_DIR=/var/lib/qht/data
# DB_FILE=/var/lib/qht/data/qht.sqlite
# UPLOADS_DIR=/var/lib/qht/uploads

# ---------------------------------------------------------------------------
# Ports. Behind a reverse proxy (Caddy, nginx) that terminates TLS, run plain
# HTTP here and leave the certificate handling to the proxy.
# ---------------------------------------------------------------------------
PORT=4000
# HTTPS_PORT=4443
# CERT_DIR=certs
