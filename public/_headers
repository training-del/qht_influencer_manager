# Cloudflare Pages response headers.

# The Android app download: served as an installable package, always saved
# rather than opened, and revalidated every time so an old build is never
# handed out after an update.
/downloads/*
  Cache-Control: no-cache

/downloads/qht-influencer.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="qht-influencer.apk"
